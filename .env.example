# ============================================================
# Safe Laravel .env.example TEMPLATE
# ------------------------------------------------------------
# Copy this to the repository root as `.env.example` (committed).
# NEVER put real values here. Placeholders and comments only.
# Developers run:  cp .env.example .env  &&  php artisan key:generate
# ============================================================

APP_NAME="Laravel"
# local | staging | production
APP_ENV=local
# Generate with: php artisan key:generate  (leave empty in the template)
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ------------------------------------------------------------
# Database  (fill real values ONLY in the real .env, never here)
# ------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Optional second connection example
# DB_CONNECTION_SECOND=mysql
# DB_HOST_SECOND=127.0.0.1
# DB_DATABASE_SECOND=
# DB_USERNAME_SECOND=
# DB_PASSWORD_SECOND=

# ------------------------------------------------------------
# Cache / Queue / Session  (redis in production is common)
# ------------------------------------------------------------
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------
# Mail  (use a real transactional provider in production)
# ------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------
# Third-party services (leave blank; set real keys outside git)
# ------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

# Generic placeholder for any project-specific token, e.g. a VCS token.
# Use a least-privilege, short-lived token and NEVER commit the value.
# GIT_TOKEN=
